{
  "name": "steam-guard-desktop",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/SunkwiBOT/steam-guard-desktop",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build": "vite build",
    "build:app": "tauri build --no-bundle -- --locked",
    "bundle:linux": "NO_STRIP=true tauri build --bundles appimage,rpm,deb -- --locked",
    "bundle:windows": "tauri build --bundles nsis -- --locked",
    "bundle:macos": "tauri build --bundles app,dmg -- --locked",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./ui/tsconfig.json",
    "lint": "oxlint --deny-warnings ui/src",
    "format": "prettier --write \"ui/src/**/*.{ts,svelte,css}\" vite.config.js",
    "format:check": "prettier --check \"ui/src/**/*.{ts,svelte,css}\" vite.config.js",
    "i18n:check": "inlang check --project ./project.inlang --missing-translations --missing-variables --unknown-variables",
    "bindings": "cargo run --quiet -p steam-guard-desktop --example export-bindings -- ui/src/lib/bindings && prettier --write ui/src/lib/bindings",
    "bindings:check": "npm run bindings && git diff --exit-code -- ui/src/lib/bindings",
    "verify": "npm run format:check && npm run lint && npm run check && npm run i18n:check && npm run bindings:check"
  },
  "devDependencies": {
    "@inlang/cli": "^3.6.0",
    "@inlang/paraglide-js": "^2.26.0",
    "@inlang/plugin-message-format": "^4.4.5",
    "@lucide/svelte": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.1",
    "@tsconfig/svelte": "^5.0.8",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  }
}
